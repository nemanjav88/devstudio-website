# Copy to .env and replace every placeholder before starting the CMS.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE
PAYLOAD_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Public origin for canonical and alternate-language URLs. Does not enable indexing.
NEXT_PUBLIC_SITE_URL=https://new.devstudio.biz
